tilelayout orbital_spaceport_layout { rotation: DIRECTION_NORTH;
    0, 0: orbital_pad_tile_0_0;
    1, 0: orbital_pad_tile_1_0;
    2, 0: orbital_pad_tile_2_0;
    3, 0: orbital_pad_tile_3_0;
    0, 1: orbital_pad_tile_0_1;
    1, 1: orbital_pad_tile_1_1;
    2, 1: orbital_pad_tile_2_1;
    3, 1: orbital_pad_tile_3_1;
    0, 2: orbital_pad_tile_0_2;
    1, 2: orbital_pad_tile_1_2;
    2, 2: orbital_pad_tile_2_2;
    3, 2: orbital_pad_tile_3_2;
    0, 3: orbital_pad_tile_0_3;
    1, 3: orbital_pad_tile_1_3;
    2, 3: orbital_pad_tile_2_3;
    3, 3: orbital_pad_tile_3_3;
}

