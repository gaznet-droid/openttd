/* Reusable rocket: dedicated orbital controller and supplied vertical rocket artwork. */
item(FEAT_AIRCRAFT, rocket, 65) {
    property {
        name:                         string(STR_ROCKET);
        climates_available:           ALL_CLIMATES;
        introduction_date:            date(2050, 1, 1);
        model_life:                   40;
        vehicle_life:                 25;
        reliability_decay:            20;
        loading_speed:                40;
        sprite_id:                    SPRITE_ID_NEW_AIRCRAFT;
        aircraft_type:                AIRCRAFT_TYPE_HELICOPTER;
        cost_factor:                  250;
        running_cost_factor:          200;
        speed:                        1800 km/h;
        acceleration:                 40;
        passenger_capacity:           200;
        mail_capacity:                40;
        refittable_cargo_classes:     bitmask(CC_PASSENGERS);
        range:                        0;
        sound_effect:                 SOUND_TAKEOFF_JET_FAST;
        badges: ["fl_format/2", "fl_id/rocket", "fl_tech/rocket", "fl_needs/launchpad",
                 "fl_role/passenger_intercity", "fl_role/express", "fl_role/freight_general",
                 "role/passenger", "role/mail", "role/freight", "power/rocket"];
    }
    graphics { default: orbital_rocket_graphics; }
    livery_override(rocket) { orbital_rocket_rotor; }
}

/* As with the helistation, the first airport based on the city airport (type 1) replaces it, so an
 * unchanged copy comes first and the spaceport is added after it. */
item(FEAT_AIRPORTS, city_airport_unchanged, 2) {
    property {
        override: 1;
    }
}

/* Preserve the stock country airport before adding the functional launch site. */
item(FEAT_AIRPORTS, country_airport_unchanged, 4) { property { override: 0; } }
item(FEAT_AIRPORTS, spaceport, 5) {
    property {
        override: 0;
        name: string(STR_SPACEPORT);
        layouts: [orbital_spaceport_layout];
        years_available: [2050, 65535];
        catchment_area: 6;
        noise_level: 20;
        maintenance_cost: 60;
        badges: ["fl_format/2", "fl_id/spaceport", "fl_tech/rocket", "fl_provides/launchpad"];
    }
}

/* Functional 4x4 Data Centre using the supplied transparent tower art. It accepts
 * valuables/gold/diamonds on ordinary buildable land, without the inherited bank
 * requirement to demolish houses. Player-funded only, strictly one per town.
 * Company-wide revenue multiplication remains outside this placement/art fix. */
item(FEAT_INDUSTRIES, data_centre, 0) {
    property {
        substitute:           INDUSTRYTYPE_TEMPERATE_BANK;
        name:                 string(STR_DATA_CENTRE);
        layouts:              [data_centre_footprint];
        spec_flags:           bitmask(IND_FLAG_DO_NOT_FORCE_INSTANCE_AT_MAP_GENERATION);
        conflicting_ind_types: [];
        cargo_types:          [accept_cargo("VALU"), accept_cargo("GOLD"), accept_cargo("DIAM")];
        fund_cost_multiplier: 255;
        prob_map_gen:         0;
        prob_in_game:         0;
        badges: ["fl_format/2", "fl_id/data_centre", "fl_industry/data_centre", "fl_market/tech"];
    }
    graphics {
        /* One data centre per town. */
        location_check: industry_town_count(data_centre) == 0 ? CB_RESULT_LOCATION_ALLOW : CB_RESULT_LOCATION_DISALLOW;
    }
}
