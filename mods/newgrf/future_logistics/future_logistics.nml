    [2, 0, 66, 320, 27, -260]
    [69, 0, 66, 338, 27, -260]
    [136, 0, 66, 360, 27, -260]
}

/* Separate idle vehicle body, also visible while servicing on its pad. */
spriteset(orbital_rocket_no_flame, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/rocket_idle_1x.png") {
    [0, 0, 19, 125, 21, -130]
    [0, 0, 19, 125, 21, -130]
    [0, 0, 19, 125, 21, -130]
    [0, 0, 19, 125, 21, -130]
}
alternative_sprites(orbital_rocket_no_flame, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/rocket_idle_2x.png") {
    [0, 0, 38, 250, 41, -260]
    [0, 0, 38, 250, 41, -260]
    [0, 0, 38, 250, 41, -260]
    [0, 0, 38, 250, 41, -260]
}

/* The rotor by flight phase (var 0xE2, the TTDPatch movement states the game reports): launching (23 at an airport,
 * 26 at a heliport) and landing (25, 28) show the rocket with flame and plume, landing being the launch in reverse;
 * climbing and flying (15 to 21) show it with its flame; anything else, on the ground, shows nothing. Each set is
 * blank for a stopped rotor, then three frames that cycle. */
switch (FEAT_AIRCRAFT, SELF, orbital_rocket_rotor, flight_state) {
    23: orbital_rocket_plume;
    25: orbital_rocket_plume;
    26: orbital_rocket_plume;
    28: orbital_rocket_plume;
    15..21: orbital_rocket_flame;
    orbital_rocket_no_flame;
}

