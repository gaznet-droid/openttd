    [0, 0, 1, 1, 0, 0]
    [2, 0, 148, 422, -14, -260]
    [151, 0, 148, 440, -14, -260]
    [300, 0, 148, 462, -14, -260]
}

/* Flight: the rocket over its flame. */
spriteset(orbital_rocket_flame, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/flame_strip_1x.png") {
    [0, 0, 1, 1, 0, 0]
