/* Cargo drone uses the supplied multirotor art, with fixed yaw during translation. */
item(FEAT_AIRCRAFT, cargo_drone, 64) {
    property {
        name:                         string(STR_CARGO_DRONE);
        climates_available:           ALL_CLIMATES;
        introduction_date:            date(2022, 1, 1);
        model_life:                   40;
        vehicle_life:                 12;
        reliability_decay:            20;
        loading_speed:                10;
        sprite_id:                    SPRITE_ID_NEW_AIRCRAFT;
        aircraft_type:                AIRCRAFT_TYPE_HELICOPTER;
        cost_factor:                  20;
        running_cost_factor:          12;
        speed:                        1609 km/h;
        acceleration:                 20;
        passenger_capacity:           8;
        mail_capacity:                0;
        /* Passengers are excluded, so the game makes mail, the first refittable cargo, the default. */
        refittable_cargo_classes:     bitmask(CC_MAIL, CC_EXPRESS);
        non_refittable_cargo_classes: bitmask(CC_PASSENGERS);
        range:                        80;
        sound_effect:                 SOUND_TAKEOFF_HELICOPTER;
        badges: ["fl_format/2", "fl_id/cargo_drone", "fl_tech/drone", "fl_needs/drone_pad",
                 "fl_role/express", "fl_role/parcel", "role/mail", "power/electric"];
    }
    graphics { default: cargo_drone_body; }
    livery_override(cargo_drone) { cargo_drone_rotor; }
}

/* The first NewGRF airport based on a built-in airport replaces it. This unchanged copy of the
 * helistation (type 8) takes that place, so the drone port below is added rather than taking the
 * helistation away from players. */
item(FEAT_AIRPORTS, helistation_unchanged, 0) {
    property {
        override: 8;
    }
}

/* Functional 4x4 rooftop Drone Port. The engine binds its tagged airport to three
 * aligned rooftop stands; the fourth visible stand is unused. */
item(FEAT_AIRPORTS, drone_port, 1) {
    property {
        override:         8;
        name:             string(STR_DRONE_PORT);
        layouts:          [drone_port_footprint];
        years_available:  [2022, 65535];
        catchment_area:   4;
        noise_level:      1;
        maintenance_cost: 10;
        badges: ["fl_format/2", "fl_id/drone_port", "fl_tech/drone", "fl_provides/drone_pad"];
    }
}

/* Hyperloop track. A track type of its own, with no fallback: nothing else runs in the tube.
 * Placeholder graphics: plain rail, until the tube art exists. */
item(FEAT_RAILTYPES, hyperloop_track) {
    property {
        label:                    "HYPL";
        name:                     string(STR_HYPERLOOP_TRACK);
        toolbar_caption:          string(STR_HYPERLOOP_TOOLBAR);
        menu_text:                string(STR_HYPERLOOP_MENU);
        build_window_caption:     string(STR_HYPERLOOP_BUILD);
        autoreplace_text:         string(STR_HYPERLOOP_REPLACE);
        new_engine_text:          string(STR_HYPERLOOP_NEW_ENGINE);
        introduction_date:        date(2035, 1, 1);
        compatible_railtype_list: ["HYPL"];
        powered_railtype_list:    ["HYPL"];
        railtype_flags:           bitmask(RAILTYPE_FLAG_NO_LEVEL_CROSSING);
        acceleration_model:       2;
        speed_limit:              3219 km/h;
        construction_cost:        2000;
        maintenance_cost:         600;
        sort_order:               0x50;
        badges: ["fl_format/2", "fl_id/hyperloop_track", "fl_tech/hyperloop"];
    }
}

