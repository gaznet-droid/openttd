/* END generated Hyperloop sprites */

/* Hyperloop track. A track type of its own, with no fallback: nothing else runs in the Hyperloop.
 * All its graphics are drawn in code by tools/hyperloop/make_hyperloop_art.py: the guideway, the viaduct
 * (its deck surface and, read by the game for the dedicated viaduct bridge, its structure), the tube portals,
 * the depot, and the toolbar icons and cursors. */
item(FEAT_RAILTYPES, hyperloop_track) {
    property {
        label:                    "HYPL";
        name:                     string(STR_HYPERLOOP_TRACK);
        toolbar_caption:          string(STR_HYPERLOOP_TOOLBAR);
        menu_text:                string(STR_HYPERLOOP_MENU);
        build_window_caption:     string(STR_HYPERLOOP_BUILD);
        autoreplace_text:         string(STR_HYPERLOOP_REPLACE);
        new_engine_text:          string(STR_HYPERLOOP_NEW_ENGINE);
        introduction_date:        date(2035, 1, 1);
        compatible_railtype_list: ["HYPL"];
        powered_railtype_list:    ["HYPL"];
        railtype_flags:           bitmask(RAILTYPE_FLAG_NO_LEVEL_CROSSING);
        acceleration_model:       2;
        speed_limit:              3219 km/h;
        construction_cost:        2000;
        maintenance_cost:         600;
        sort_order:               0x50;
        badges: ["fl_format/2", "fl_id/hyperloop_track", "fl_tech/hyperloop"];
    }
    graphics {
        gui:             hyperloop_gui_sprites;
        underlay:        hyperloop_track_underlay_sprites;
        track_overlay:   hyperloop_track_overlay_sprites;
        tunnels:         hyperloop_tunnel_ground_sprites;
        tunnel_overlay:  hyperloop_tunnel_portal_sprites;
        bridge_surfaces: hyperloop_bridge_sprites;
        depots:          hyperloop_depots_sprites;
        fences:          hyperloop_fences_sprites;
    }
}

/* Hyperloop terminal. A glass-roofed platform hall over the guideway, with company-colour fascias along the eaves
 * and glowing platform edges; pods stay visible under the translucent roof. The game builds it for every Hyperloop
 * station, whichever station type was chosen, and only on Hyperloop track (src/future_logistics/hyperloop.cpp). */
spritelayout hyperloop_terminal_x {
    ground { sprite: 1012; }
    building { sprite: hyperloop_terminal_sprites(0); xoffset: 0; yoffset: 0;  zoffset: 0; xextent: 16; yextent: 5; zextent: 18;
               recolour_mode: RECOLOUR_REMAP; palette: PALETTE_USE_DEFAULT; }
    building { sprite: hyperloop_terminal_sprites(1); xoffset: 0; yoffset: 11; zoffset: 0; xextent: 16; yextent: 5; zextent: 18;
               recolour_mode: RECOLOUR_REMAP; palette: PALETTE_USE_DEFAULT; }
}
spritelayout hyperloop_terminal_y {
    ground { sprite: 1011; }
    building { sprite: hyperloop_terminal_sprites(2); xoffset: 0;  yoffset: 0; zoffset: 0; xextent: 5; yextent: 16; zextent: 18;
               recolour_mode: RECOLOUR_REMAP; palette: PALETTE_USE_DEFAULT; }
    building { sprite: hyperloop_terminal_sprites(3); xoffset: 11; yoffset: 0; zoffset: 0; xextent: 5; yextent: 16; zextent: 18;
               recolour_mode: RECOLOUR_REMAP; palette: PALETTE_USE_DEFAULT; }
}
item(FEAT_STATIONS, hyperloop_terminal_station, 0) {
    property {
        class:     "HYPL";
        classname: string(STR_HYPERLOOP_TERMINAL_CLASS);
        name:      string(STR_HYPERLOOP_TERMINAL);
        badges:    ["fl_format/2", "fl_tech/hyperloop"];
    }
    graphics {
        sprite_layouts: [hyperloop_terminal_x, hyperloop_terminal_y];
        default: hyperloop_terminal_sprites;
    }
}

/* Propulsion pod: pulls the capsules. Drawn by tools/hyperloop/make_hyperloop_art.py, in company colours. */
item(FEAT_TRAINS, hyperloop_pod, 120) {
    property {
        name:                string(STR_HYPERLOOP_POD);
        climates_available:  ALL_CLIMATES;
        introduction_date:   date(2035, 1, 1);
        model_life:          40;
        vehicle_life:        30;
        reliability_decay:   10;
        track_type:          HYPL;
        sprite_id:           SPRITE_ID_NEW_TRAIN;
        engine_class:        ENGINE_CLASS_MAGLEV;
        speed:               3219 km/h;
        power:               12000 kW;
        weight:              40 ton;
        tractive_effort_coefficient: 0.3;
        cost_factor:         200;
        running_cost_factor: 150;
        running_cost_base:   RUNNING_COST_ELECTRIC;
        cargo_capacity:      0;
        badges: ["fl_format/2", "fl_id/hyperloop_pod", "fl_tech/hyperloop", "role/express", "power/electric"];
    }
    graphics { default: hyperloop_pod_sprites; }
}

