tilelayout drone_port_footprint {
    rotation: DIRECTION_NORTH;
    0, 0: drone_port_0_0_tile;
    1, 0: drone_port_1_0_tile;
    2, 0: drone_port_2_0_tile;
    3, 0: drone_port_3_0_tile;
    0, 1: drone_port_0_1_tile;
    1, 1: drone_port_1_1_tile;
    2, 1: drone_port_2_1_tile;
    3, 1: drone_port_3_1_tile;
    0, 2: drone_port_0_2_tile;
    1, 2: drone_port_1_2_tile;
    2, 2: drone_port_2_2_tile;
    3, 2: drone_port_3_2_tile;
    0, 3: drone_port_0_3_tile;
    1, 3: drone_port_1_3_tile;
    2, 3: drone_port_2_3_tile;
    3, 3: drone_port_3_3_tile;
}

