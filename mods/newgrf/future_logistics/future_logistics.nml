/*
 * Future Logistics NewGRF. GPL-2.0-only.
 *
 * New technology that arrives over the decades, described with the shared tech format
 * (docs/future_logistics/tech_format.md) so rival companies find and adopt it. Every number
 * here is a placeholder until the balance pass; see PLACEHOLDERS.md. Graphics are placeholders
 * too: base-game sprites stand in until the art is converted.
 *
 * Build with NML 0.9.0: ./build.sh
 */
grf {
    grfid: "FL\01\01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 2;
    min_compatible_version: 2;
}

cargotable {
    PASS, MAIL, VALU, GOLD, DIAM
}

railtypetable {
    HYPL
}

badgetable {
    "fl_format/2",
    /* Drones: a tech family built with the airport pair mechanic, for mail between towns. */
    "fl_family/drone",
    "fl_family/drone/mechanic/airport_pair",
    "fl_family/drone/market/mail",
    "fl_family/drone/min_tier/town",
    "fl_tech/drone",
    "fl_needs/drone_pad",
    "fl_provides/drone_pad",
    "fl_role/express",
    "fl_role/parcel",
    "fl_id/cargo_drone",
    "fl_id/drone_port",
    /* Metro & Regional already runs mail by road; it takes up drones a year after they arrive.
     * AeroLink adopts every new air family two years after it arrives by its own rule. */
    "fl_profile/metro_regional/adopt/drone/airport_pair/mail/1",
    /* Hyperloop: a tech family on its own track type, built with the rail line mechanic. National Rail
     * adopts it five years after it arrives by its rule for any new rail family. */
    "fl_family/hyperloop",
    "fl_family/hyperloop/mechanic/rail_line",
    "fl_family/hyperloop/market/town_pair",
    "fl_family/hyperloop/market/mail",
    "fl_family/hyperloop/min_tier/city",
    "fl_tech/hyperloop",
    "fl_id/hyperloop_track",
    "fl_id/hyperloop_pod",
    "fl_id/hyperloop_passenger_capsule",
    "fl_id/hyperloop_mail_capsule",
    /* Rockets: a tech family built with the airport pair mechanic between spaceports. AeroLink adopts it two
     * years after it arrives by its rule for any new air family; Integrated Logistics uses it for freight. */
    "fl_family/rocket",
    "fl_family/rocket/mechanic/airport_pair",
    "fl_family/rocket/market/town_pair",
    "fl_family/rocket/market/mail",
    "fl_family/rocket/market/industry",
    "fl_family/rocket/min_tier/city",
    "fl_tech/rocket",
    "fl_needs/launchpad",
    "fl_provides/launchpad",
    "fl_role/passenger_intercity",
    "fl_role/freight_general",
    "fl_id/rocket",
    "fl_id/spaceport",
    "fl_profile/integrated_logistics/adopt/rocket/airport_pair/industry/3",
    "role/freight",
    "power/rocket",
    /* Data centres: an industry in the "tech" market that receives what banks hold. */
    "fl_industry/data_centre",
    "fl_market/tech",
    "fl_id/data_centre",
    "fl_profile/integrated_logistics/industries/tech",
    /* Shared badge classes from the NewGRF specification, for other NewGRFs, AIs and the purchase list. */
    "role/mail",
    "role/express",
    "role/passenger",
    "power/electric",
}

/* Only the family has a display name; the fl_ classes stay unnamed so players never see them. */
item(FEAT_BADGES, family_drone, 0) { property { label: "fl_family/drone"; name: string(STR_FAMILY_DRONE); } }
item(FEAT_BADGES, family_hyperloop, 1) { property { label: "fl_family/hyperloop"; name: string(STR_FAMILY_HYPERLOOP); } }
item(FEAT_BADGES, family_rocket, 2) { property { label: "fl_family/rocket"; name: string(STR_FAMILY_ROCKET); } }

/* BEGIN GENERATED FUNCTIONAL SPRITES */
