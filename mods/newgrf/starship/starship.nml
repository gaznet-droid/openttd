spritelayout pad_d_2_3_layout { ground { sprite: GROUNDSPRITE_CONCRETE; } building { sprite: pad_d_2_3(0); xextent: 16; yextent: 16; zextent: 160; } }
switch (FEAT_AIRPORTTILES, SELF, pad_switch_2_3, animation_frame) { 1: pad_d_2_3_layout; pad_e_2_3_layout; }
item(FEAT_AIRPORTTILES, pad_tile_2_3, 11) { property { substitute: 0; } graphics { default: pad_switch_2_3; } }
tilelayout starship_pad_layout { rotation: DIRECTION_EAST;
    0, 0: pad_tile_0_0;
    1, 0: pad_tile_1_0;
    2, 0: pad_tile_2_0;
    0, 1: pad_tile_0_1;
    1, 1: pad_tile_1_1;
    2, 1: pad_tile_2_1;
    0, 2: pad_tile_0_2;
    1, 2: pad_tile_1_2;
    2, 2: pad_tile_2_2;
    0, 3: pad_tile_0_3;
    1, 3: pad_tile_1_3;
    2, 3: pad_tile_2_3;
}
spriteset(pad_preview, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/pad_preview_1x.png") { [0, 0, 96, 104, -48, -52] }
alternative_sprites(pad_preview, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/pad_preview_2x.png") { [0, 0, 192, 209, -96, -105] }
/* END generated spaceport pad */

/* The first NewGRF airport based on a built-in airport replaces it. This unchanged copy of the country airport
 * takes that place, so the launch site is added rather than taking the country airport away from players. */
item(FEAT_AIRPORTS, country_airport_unchanged, 0) {
    property {
        override: 0;
    }
}

item(FEAT_AIRPORTS, starship_launch_site, 1) {
    property {
        override:         0;
        name:             string(STR_STARSHIP_LAUNCH_SITE);
        layouts:          [starship_pad_layout];
        years_available:  [2045, 65535];
        catchment_area:   12;
        noise_level:      25;
        maintenance_cost: 80;
        badges: ["fl_format/2", "fl_id/starship_launch_site", "fl_tech/rocket", "fl_provides/launchpad"];
    }
    graphics {
        default: pad_preview;
    }
}
