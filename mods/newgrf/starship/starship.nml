spritelayout pad_d_1_3_layout { ground { sprite: GROUNDSPRITE_CONCRETE; } building { sprite: pad_d_1_3(0); xextent: 16; yextent: 16; zextent: 160; } }
switch (FEAT_AIRPORTTILES, SELF, pad_switch_1_3, animation_frame) { 1: pad_d_1_3_layout; pad_e_1_3_layout; }
item(FEAT_AIRPORTTILES, pad_tile_1_3, 10) { property { substitute: 0; } graphics { default: pad_switch_1_3; } }
